MICRODUCK_REPO=../microduck
MICRODUCK_RL_REPO=../microduck_rl
MICRODUCK_ROBOTD_SOCKET=/run/robotd.sock
MICRODUCK_BODY_HOST=127.0.0.1
MICRODUCK_BODY_PORT=7801
MICRODUCK_RENDER_WIDTH=1280
MICRODUCK_RENDER_HEIGHT=720
MICRODUCK_RENDER_FPS=24
MICRODUCK_RENDER_QUALITY=95
# Set explicitly only when overriding the selected mode (osmesa, egl, or glfw).
# MICRODUCK_MUJOCO_GL=osmesa
MICRODUCK_STUDIO_HOST=0.0.0.0
MICRODUCK_STUDIO_PORT=8090
MICRODUCK_STUDIO_ENABLE_JOBS=false
